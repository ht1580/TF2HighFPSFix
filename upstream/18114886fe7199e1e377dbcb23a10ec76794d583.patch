+CLC_ClientTick::CLC_ClientTick()
+	: m_nDeltaTick(0), m_nStringTableTick(0), m_flFrameTime(0), m_flFrameTimeStdDeviation(0), m_nServerCPU(0)
+{
+	m_nGroup = 0;
+	m_bReliable = false;
+	m_NetChannel = nullptr;
